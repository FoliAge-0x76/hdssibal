# 复制为 .env.local 后填写。用于本地开发；部署到 GitHub Pages 时仓库坐标会自动推断，无需配置。
# 变量只有 VITE_ 前缀的才会暴露给前端代码，不要把任何密钥写进这里。

# 仓库坐标（仓库即数据库）
VITE_GITHUB_OWNER=YOUR_GITHUB_USERNAME
VITE_GITHUB_REPO=YOUR_REPO_NAME
VITE_GITHUB_BRANCH=main

# 可选：一键登录时申请的权限范围（只是把请求转达给中转层）。
# 默认 public_repo（公开仓库的读写）；若希望提交到私有仓库，改成 repo。
VITE_OAUTH_SCOPES=public_repo